{
  "id": "sdcpp",
  "name": "stable-diffusion.cpp",
  "type": "model",
  "source": "examples/modal/modly_extension",
  "description": "Text-to-image via a pinned sd-cli container. The Modly side only sends a stable request; flag discovery and model downloads happen on Modal.",
  "version": "0.1.0",
  "author": "sdcpp-hooks",
  "generator_class": "SDCppGenerator",
  "tags": [
    "text-to-image",
    "sdcpp",
    "decoupled"
  ],
  "nodes": [
    {
      "id": "txt2img",
      "name": "sd.cpp Text to Image",
      "input": "text",
      "output": "image",
      "params_schema": [
        {
          "id": "prompt",
          "label": "Prompt",
          "type": "text",
          "default": "a lovely cat",
          "tooltip": "Text prompt. Also accepted as params.text."
        },
        {
          "id": "negative_prompt",
          "label": "Negative Prompt",
          "type": "text",
          "default": "",
          "tooltip": "Optional negative prompt."
        },
        {
          "id": "recipe",
          "label": "Recipe",
          "type": "select",
          "default": "sd15",
          "options": [
            {
              "value": "sd15",
              "label": "SD 1.5"
            }
          ],
          "tooltip": "Bundled model recipe. Override with model if set."
        },
        {
          "id": "model",
          "label": "Model URI",
          "type": "text",
          "default": "",
          "tooltip": "hf://, civitai://, https://, or a volume path. Empty uses the recipe."
        },
        {
          "id": "width",
          "label": "Width",
          "type": "int",
          "default": 512,
          "min": 64,
          "max": 2048
        },
        {
          "id": "height",
          "label": "Height",
          "type": "int",
          "default": 512,
          "min": 64,
          "max": 2048
        },
        {
          "id": "steps",
          "label": "Steps",
          "type": "int",
          "default": 20,
          "min": 1,
          "max": 150
        },
        {
          "id": "cfg_scale",
          "label": "CFG Scale",
          "type": "float",
          "default": 7.0,
          "min": 0.0,
          "max": 30.0,
          "step": 0.5
        },
        {
          "id": "seed",
          "label": "Seed",
          "type": "int",
          "default": 42,
          "min": -1,
          "max": 2147483647
        }
      ]
    }
  ]
}
